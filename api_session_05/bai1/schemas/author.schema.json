{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "integer",
      "minimum": 1
    }
  },
  "title": "Author",
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "biography": {
      "type": "string",
      "maxLength": 3000
    },
    "website": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "id",
    "name"
  ]
}
