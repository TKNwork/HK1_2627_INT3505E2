{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "integer",
      "minimum": 1
    }
  },
  "title": "Review",
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "book_id": {
      "$ref": "#/$defs/id"
    },
    "user_id": {
      "$ref": "#/$defs/id"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "hidden"
      ]
    }
  },
  "required": [
    "id",
    "book_id",
    "user_id",
    "rating",
    "comment",
    "created_at",
    "status"
  ]
}
